{
  "name": "cryptoscanner",
  "version": "0.1.0",
  "private": true,
  "description": "Independent crypto card comparator (affiliate-funded). Public site in English.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node --experimental-strip-types scripts/validate-data.ts",
    "test": "node --experimental-strip-types --test \"src/lib/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "expire": "node --experimental-strip-types scripts/expire-promos.ts",
    "ui-check": "node scripts/ui-check.mjs",
    "preview-export": "python3 scripts/export-preview.py dist ../preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "typescript": "5.9.3"
  }
}
