# Copy to .env — never commit secrets. All variables below are build-time, public and optional.

# Which dataset the site is built from:
#   verified = data/cards (published records only; the only dataset allowed on a public domain)
#   demo     = data/demo/cards (fictional records; pages carry noindex and a visible banner)
PUBLIC_DATASET=demo

# Canonical site URL once a domain exists (used for canonicals, sitemap, Open Graph).
PUBLIC_SITE_URL=

# Name of the publishing entity shown on legal pages. Empty = "publisher not yet designated" notice.
PUBLIC_PUBLISHER_NAME=
