---
import { knownCountries } from '../lib/data.ts';
// Country names: a small built-in map for Europe-first launch; falls back to the ISO code.
const NAMES: Record<string, string> = { AT: 'Austria', BE: 'Belgium', BG: 'Bulgaria', CH: 'Switzerland', CY: 'Cyprus', CZ: 'Czechia', DE: 'Germany', DK: 'Denmark', EE: 'Estonia', ES: 'Spain', FI: 'Finland', FR: 'France', GB: 'United Kingdom', GR: 'Greece', HR: 'Croatia', HU: 'Hungary', IE: 'Ireland', IS: 'Iceland', IT: 'Italy', LI: 'Liechtenstein', LT: 'Lithuania', LU: 'Luxembourg', LV: 'Latvia', MT: 'Malta', NL: 'Netherlands', NO: 'Norway', PL: 'Poland', PT: 'Portugal', RO: 'Romania', SE: 'Sweden', SI: 'Slovenia', SK: 'Slovakia', US: 'United States' };
const codes = [...new Set([...Object.keys(NAMES), ...knownCountries()])].sort((a, b) => (NAMES[a] ?? a).localeCompare(NAMES[b] ?? b));
---
<div class="field">
  <label for="country">Country of residence</label>
  <select id="country" name="country" autocomplete="country">
    <option value="">Choose your country</option>
    {codes.map((c) => <option value={c}>{NAMES[c] ?? c}</option>)}
  </select>
  <p class="muted" style="font-size:0.85rem;margin:6px 0 0">Availability is judged on published residence rules, not on where the card network is accepted. Stored on this device only.</p>
</div>
<script>
  const KEY = 'cs.country';
  const sel = document.getElementById('country') as HTMLSelectElement | null;
  if (sel) {
    try { const saved = localStorage.getItem(KEY); if (saved) sel.value = saved; } catch {}
    const apply = () => {
      const c = sel.value;
      try { if (c) localStorage.setItem(KEY, c); else localStorage.removeItem(KEY); } catch {}
      document.dispatchEvent(new CustomEvent('cs:country', { detail: c }));
    };
    sel.addEventListener('change', apply);
    apply();
  }
</script>
