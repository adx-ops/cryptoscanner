---
import countries from '../lib/countries.json';
import { allCards } from '../lib/data.ts';
// Worldwide selector (ICU region names). Countries with at least one card listing them as allowed are grouped first.
const NAMES = countries as Record<string, string>;
const withData = new Set<string>();
for (const c of allCards()) for (const v of c.variants) v.eligibility.residence_allowed.forEach((x) => withData.add(x));
const byName = (a: string, b: string) => (NAMES[a] ?? a).localeCompare(NAMES[b] ?? b);
const first = [...withData].filter((c) => NAMES[c]).sort(byName);
const rest = Object.keys(NAMES).filter((c) => !withData.has(c)).sort(byName);
---
<div class="field">
  <label for="country">Country of residence</label>
  <select id="country" name="country" autocomplete="country">
    <option value="">Choose your country</option>
    {first.length > 0 && <optgroup label="Countries with at least one listed card">{first.map((c) => <option value={c}>{NAMES[c]}</option>)}</optgroup>}
    <optgroup label="All countries">{rest.map((c) => <option value={c}>{NAMES[c]}</option>)}</optgroup>
  </select>
  <p class="hint">Judged on each provider's published residence rules, never on where the card network is accepted. Your choice stays on this device.</p>
</div>
<script>
  const KEY = 'cs.country';
  const sel = document.getElementById('country') as HTMLSelectElement | null;
  if (sel) {
    try { const saved = localStorage.getItem(KEY); if (saved) sel.value = saved; } catch {}
    const apply = () => {
      const c = sel.value;
      try { if (c) localStorage.setItem(KEY, c); else localStorage.removeItem(KEY); } catch {}
      document.dispatchEvent(new CustomEvent('cs:country', { detail: c }));
    };
    sel.addEventListener('change', apply);
    apply();
  }
</script>
