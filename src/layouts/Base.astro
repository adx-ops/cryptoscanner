---
import { IS_DEMO } from '../lib/data.ts';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string }
const { title, description, noindex = false, canonicalPath } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL;
const robots = (IS_DEMO || noindex) ? 'noindex, nofollow' : 'index, follow';
const canonical = site && canonicalPath ? new URL(canonicalPath, site).toString() : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · CryptoScanner</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {IS_DEMO && (
      <div class="demo-banner" role="status">
        Demonstration build with <strong>fictional cards</strong>. Nothing here is verified. Not indexable.
      </div>
    )}
    <header class="site-header">
      <nav aria-label="Main">
        <a class="brand" href="/">Crypto<span>Scanner</span></a>
        <ul>
          <li><a href="/compare">Compare</a></li>
          <li><a href="/calculator">Calculator</a></li>
          <li><a href="/methodology">Method</a></li>
          <li><a href="/how-we-make-money">Funding</a></li>
        </ul>
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>CryptoScanner compares published card conditions. It does not hold funds, run identity checks or submit applications. Listing a card is not a guarantee that an issuer will accept you. Nothing here is financial, legal or tax advice.</p>
      <p>Some outbound links may be affiliate links; they are marked and never change the editorial ranking. <a href="/how-we-make-money">How we make money</a> · <a href="/methodology">Methodology</a> · <a href="/contact">Report an error</a> · <a href="/legal">Legal &amp; privacy</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbf9; --fg: #15181d; --muted: #5a606b; --line: #e3e4e0; --card: #ffffff;
    --accent: #0b6e4f; --accent-fg: #ffffff; --warn-bg: #fff4d6; --warn-fg: #6b4e00; --bad: #a3321f;
    --radius: 12px; --tap: 44px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 16px; line-height: 1.5;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0f1216; --fg: #ecefef; --muted: #a2a8b3; --line: #262b33; --card: #171b21; --accent: #4fc39a; --accent-fg: #06201a; --warn-bg: #3a2f0e; --warn-fg: #ffd87a; --bad: #ff8b73; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--fg); overflow-x: hidden; }
  body { min-height: 100dvh; display: flex; flex-direction: column; }
  main { flex: 1; }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--accent); color: var(--accent-fg); padding: 8px 12px; border-radius: 8px; }
  .skip:focus { left: 8px; z-index: 10; }
  .container { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  .demo-banner { background: var(--warn-bg); color: var(--warn-fg); padding: 10px 16px; text-align: center; font-size: 0.9rem; }
  .site-header nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; max-width: 1040px; margin: 0 auto; }
  .site-header ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; flex-wrap: wrap; }
  .site-header li a { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 10px; text-decoration: none; color: var(--fg); border-radius: 8px; }
  .site-header li a:hover { background: var(--line); }
  .brand { font-weight: 700; text-decoration: none; color: var(--fg); font-size: 1.15rem; letter-spacing: -0.01em; }
  .brand span { color: var(--accent); }
  .site-footer { border-top: 1px solid var(--line); margin-top: 48px; padding-top: 20px; padding-bottom: 32px; color: var(--muted); font-size: 0.85rem; }
  h1 { font-size: clamp(1.5rem, 4vw, 2.2rem); line-height: 1.15; letter-spacing: -0.02em; margin: 24px 0 8px; }
  h2 { font-size: 1.25rem; margin: 28px 0 8px; }
  .muted { color: var(--muted); }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--tap); padding: 0 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--card); color: var(--fg); text-decoration: none; font-weight: 600; cursor: pointer; }
  .btn.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
  .btn[aria-disabled="true"] { opacity: 0.5; pointer-events: none; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
  .grid { display: grid; gap: 12px; }
  @media (min-width: 768px) { .grid.cols-2 { grid-template-columns: 1fr 1fr; } }
  .kv { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 4px 12px; font-size: 0.95rem; margin: 0; }
  .kv dt { color: var(--muted); } .kv dd { margin: 0; overflow-wrap: anywhere; }
  .badge { display: inline-block; font-size: 0.75rem; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .badge.ok { border-color: var(--accent); color: var(--accent); }
  .badge.bad { border-color: var(--bad); color: var(--bad); }
  .badge.unk { background: var(--warn-bg); color: var(--warn-fg); border-color: transparent; }
  label { display: block; font-weight: 600; margin-bottom: 4px; }
  select, input { width: 100%; min-height: var(--tap); padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--fg); font: inherit; }
  .field { margin-bottom: 14px; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  th { color: var(--muted); font-weight: 600; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
