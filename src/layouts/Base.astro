---
import '@fontsource-variable/archivo/standard.css';
import { IS_DEMO, NOINDEX, url, allCards } from '../lib/data.ts';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string; wide?: boolean }
const { title, description, noindex = false, canonicalPath, wide = false } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL;
const robots = (IS_DEMO || NOINDEX || noindex) ? 'noindex, nofollow' : 'index, follow';
const canonical = site && canonicalPath ? new URL(url(canonicalPath), site).toString() : null;
// Footer facts computed at build time from the records themselves.
const lastVerified = allCards().map((c) => c.freshness.last_content_verified_at ?? '').filter(Boolean).sort().at(-1)?.slice(0, 10) ?? null;
const publishedCount = allCards().filter((c) => c.record_status === 'published' || c.is_demo).length;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · CryptoScanner</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {IS_DEMO && (
      <div class="demo-banner" role="status">
        Demonstration build with <strong>fictional cards</strong>. Nothing here is verified. Not indexable.
      </div>
    )}
    <header class="site-header">
      <nav aria-label="Main">
        <a class="brand" href={url('/')} aria-label="CryptoScanner home">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="2" y="7" width="28" height="18" rx="3.5" fill="currentColor"/><rect x="6" y="13" width="7" height="5" rx="1" fill="var(--bg)"/><path d="M17 11v10" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/></svg>
          <span class="brand-word">CryptoScanner</span>
        </a>
        <ul>
          <li><a href={url('/')}>Cards</a></li>
          <li><a href={url('/compare')}>Compare</a></li>
          <li><a href={url('/calculator')}>Calculator</a></li>
          <li><a href={url('/methodology')}>Method</a></li>
          <li><a href={url('/how-we-make-money')}>Funding</a></li>
        </ul>
        <a class="btn primary nav-cta" href={url('/#picks')}>Find my card</a>
      </nav>
    </header>
    <main id="main" class={`container${wide ? ' wide' : ''}`}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container foot">
        <div>
          <p class="foot-brand">CryptoScanner</p>
          <p>Crypto cards compared on their published conditions. Every figure carries its source and the date it was checked. Unknown stays unknown — never shown as zero or free.</p>
          {lastVerified && <p class="foot-fact">{publishedCount} card{publishedCount === 1 ? '' : 's'} verified · sources last checked {lastVerified}</p>}
        </div>
        <div>
          <p class="foot-h">Site</p>
          <ul>
            <li><a href={url('/')}>All cards</a></li>
            <li><a href={url('/compare')}>Compare</a></li>
            <li><a href={url('/calculator')}>Calculator</a></li>
            <li><a href={url('/graveyard')}>Closed cards</a></li>
          </ul>
        </div>
        <div>
          <p class="foot-h">Trust</p>
          <ul>
            <li><a href={url('/methodology')}>How cards are verified</a></li>
            <li><a href={url('/how-we-make-money')}>How we make money</a></li>
            <li><a href={url('/contact')}>Report an error</a></li>
            <li><a href={url('/legal')}>Legal &amp; privacy</a></li>
          </ul>
        </div>
        <p class="foot-legal">CryptoScanner does not hold funds, run identity checks or submit applications. Listing a card is not a guarantee that an issuer will accept you. Nothing here is financial, legal or tax advice. Some outbound links are affiliate links; they are marked and never change the ranking. Card names, logos and product images belong to their owners and identify the products compared.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Black, white, one lime signal. One self-hosted variable typeface (Archivo, weight + width):
     expanded heavy caps for display, normal width for reading. */
  :root {
    --bg: #000000; --surface: #0d0d0d; --surface-2: #171717; --line: #232323; --line-strong: #363636;
    --fg: #ffffff; --muted: #a3a3a3; --faint: #6b6b6b;
    --accent: #d7ff3c; --accent-fg: #0a0a0a; --accent-soft: rgba(215, 255, 60, 0.12);
    --ok: #d7ff3c; --ok-soft: rgba(215, 255, 60, 0.12);
    --unk: #b9b9b9; --unk-soft: rgba(255, 255, 255, 0.06);
    --bad: #ff6a5c; --bad-soft: rgba(255, 106, 92, 0.14);
    --warn-bg: #2a2300; --warn-fg: #ffe27a;
    --face-a: #262626; --face-b: #0a0a0a;
    --r-panel: 16px; --r-face: 14px; --r-ctl: 10px; --tap: 44px;
    --font: "Archivo Variable", "Archivo", "Helvetica Neue", Arial, sans-serif;
    --shadow-face: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
    color-scheme: dark;
    font-family: var(--font); font-size: 16px; line-height: 1.5;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) { --bg: #f6f7f9; --surface: #ffffff; --surface-2: #eceef2; --line: #e1e4ea; --line-strong: #c9ced9; --fg: #0a0a0a; --muted: #5b6270; --faint: #8a93a6; --accent: #2f5a00; --accent-fg: #ffffff; --accent-soft: rgba(47, 90, 0, 0.1); --ok: #2f5a00; --ok-soft: rgba(47, 90, 0, 0.1); --unk: #6b6b6b; --unk-soft: rgba(0, 0, 0, 0.05); --bad: #b3261e; --bad-soft: rgba(179, 38, 30, 0.08); --warn-bg: #fff3cd; --warn-fg: #6b4e00; --face-a: #2a2a2a; --face-b: #0a0a0a; --shadow-face: 0 20px 40px -22px rgba(0, 0, 0, 0.45); color-scheme: light; }
  }
  :root[data-theme="light"] { --bg: #f6f7f9; --surface: #ffffff; --surface-2: #eceef2; --line: #e1e4ea; --line-strong: #c9ced9; --fg: #0a0a0a; --muted: #5b6270; --faint: #8a93a6; --accent: #2f5a00; --accent-fg: #ffffff; --accent-soft: rgba(47, 90, 0, 0.1); --ok: #2f5a00; --ok-soft: rgba(47, 90, 0, 0.1); --unk: #6b6b6b; --unk-soft: rgba(0, 0, 0, 0.05); --bad: #b3261e; --bad-soft: rgba(179, 38, 30, 0.08); --warn-bg: #fff3cd; --warn-fg: #6b4e00; --face-a: #2a2a2a; --face-b: #0a0a0a; --shadow-face: 0 20px 40px -22px rgba(0, 0, 0, 0.45); color-scheme: light; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--fg); overflow-x: hidden; }
  body { min-height: 100dvh; display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; }
  main { flex: 1; }
  a { color: var(--fg); text-decoration-color: var(--accent); text-underline-offset: 3px; }
  a:hover { text-decoration-color: var(--fg); }
  a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible, summary:focus-visible, label:has(> input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--accent); color: var(--accent-fg); padding: 8px 12px; border-radius: 8px; }
  .skip:focus { left: 8px; z-index: 10; }
  .container { width: 100%; max-width: 1160px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .demo-banner { background: var(--warn-bg); color: var(--warn-fg); padding: 10px 16px; text-align: center; font-size: 0.9rem; }

  /* Header */
  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
  .site-header nav { display: flex; align-items: center; gap: 12px; padding: 8px 16px; max-width: 1160px; margin: 0 auto; flex-wrap: wrap; }
  .site-header ul { list-style: none; display: flex; gap: 2px; margin: 0 auto 0 8px; padding: 0; flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; max-width: 100%; }
  .site-header ul::-webkit-scrollbar { display: none; }
  .nav-cta { margin-left: auto; min-height: 38px; padding: 0 14px; font-size: 0.9rem; }
  @media (max-width: 639px) { .site-header ul { order: 3; width: 100%; margin-left: -10px; padding-right: 16px; } .nav-cta { margin-left: auto; } }
  .site-header li a { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 11px; text-decoration: none; color: var(--muted); border-radius: var(--r-ctl); font-weight: 600; font-size: 0.9rem; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.04em; }
  .site-header li a:hover { color: var(--fg); background: var(--surface-2); }
  .brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--fg); min-height: var(--tap); }
  .brand-mark { width: 26px; height: 26px; }
  .brand-word { font-weight: 800; font-stretch: 112%; font-size: 1.05rem; letter-spacing: -0.01em; text-transform: uppercase; }

  /* Display type: expanded heavy caps. Reading type: normal width. */
  .display, h1, h2 { font-weight: 800; font-stretch: 115%; text-transform: uppercase; letter-spacing: -0.01em; line-height: 0.98; text-wrap: balance; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.9rem); margin: 28px 0 14px; }
  h2 { font-size: clamp(1.35rem, 3.2vw, 2rem); margin: 44px 0 14px; }
  h3 { font-weight: 700; font-size: 1.1rem; line-height: 1.25; letter-spacing: -0.01em; margin: 20px 0 6px; }
  h4 { font-weight: 700; font-size: 0.8rem; margin: 14px 0 6px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
  p { margin: 0 0 12px; }
  .muted { color: var(--muted); }
  .hint { color: var(--muted); font-size: 0.875rem; margin: 6px 0 0; }
  .lede { font-size: 1.1rem; color: var(--muted); max-width: 38rem; line-height: 1.5; }
  .num { font-variant-numeric: tabular-nums; }
  .kicker { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin: 0 0 8px; }

  /* Controls */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: var(--tap); padding: 0 18px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--fg); text-decoration: none; font: inherit; font-weight: 700; font-size: 0.95rem; cursor: pointer; white-space: nowrap; }
  .btn:hover { border-color: var(--fg); background: var(--surface-2); }
  .btn.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
  .btn.primary:hover { filter: brightness(1.08); background: var(--accent); }
  .btn.lg { min-height: 52px; padding: 0 26px; font-size: 1.05rem; }
  .btn[aria-disabled="true"] { opacity: 0.45; pointer-events: none; }
  label { display: block; font-weight: 600; margin-bottom: 6px; }
  select, input { width: 100%; min-height: var(--tap); padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: var(--r-ctl); background: var(--surface); color: var(--fg); font: inherit; }
  .field { margin-bottom: 14px; min-width: 0; }

  /* Surfaces */
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-panel); padding: 18px; min-width: 0; }
  .grid { display: grid; gap: 14px; }
  @media (min-width: 700px) { .grid.cols-2 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 700px) and (max-width: 999px) { .grid.cols-3 { grid-template-columns: 1fr 1fr; } }
  .kv { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 8px 14px; font-size: 0.95rem; margin: 0; }
  .kv dt { color: var(--muted); } .kv dd { margin: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }

  /* Status language: verified = lime, unknown = dashed grey, contradiction = coral */
  .badge { display: inline-flex; align-items: center; gap: 6px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--muted); white-space: nowrap; line-height: 1.4; vertical-align: middle; }
  .badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
  .badge.ok { border-color: transparent; background: var(--ok-soft); color: var(--ok); }
  .badge.bad { border-color: transparent; background: var(--bad-soft); color: var(--bad); }
  .badge.unk { background: var(--unk-soft); color: var(--unk); border: 1px dashed currentColor; }
  .badge.unk::before { background: transparent; border: 1.5px solid currentColor; width: 5px; height: 5px; }

  /* Fact chips (tiles, rows, card page) */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 5px 10px; border-radius: 6px; background: var(--surface-2); border: 1px solid var(--line); color: var(--fg); white-space: nowrap; }
  .chip b { color: var(--accent); font-weight: 800; }
  .chip.unk { color: var(--muted); border-style: dashed; }
  .chip.unk b { color: var(--muted); }
  .chip.bad b { color: var(--bad); }
  .verified-mark { display: inline-flex; align-items: center; gap: 5px; color: var(--accent); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .verified-mark::before { content: "✓"; display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); color: var(--accent-fg); font-size: 0.7rem; }

  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  th, td { text-align: left; padding: 12px 12px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  tr:last-child td, tr:last-child th { border-bottom: 0; }
  th { color: var(--muted); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; }
  td { font-variant-numeric: tabular-nums; }
  details summary { cursor: pointer; min-height: var(--tap); display: flex; align-items: center; font-weight: 700; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .plain { list-style: none; padding: 0; margin: 0; }
  .prose { max-width: 44rem; } .prose p, .prose li { font-size: 1.02rem; line-height: 1.6; } .prose h1 { margin-top: 36px; } .prose h2 { margin-top: 36px; }

  /* Footer */
  .site-footer { border-top: 1px solid var(--line); margin-top: 72px; padding: 40px 0 44px; color: var(--muted); font-size: 0.9rem; background: var(--surface); }
  .foot { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .foot { grid-template-columns: 2fr 1fr 1fr; } .foot-legal { grid-column: 1 / -1; } }
  .foot-brand { color: var(--fg); font-weight: 800; font-stretch: 112%; text-transform: uppercase; font-size: 1.05rem; margin: 0 0 8px; }
  .foot-fact { color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }
  .foot-h { color: var(--fg); font-weight: 700; margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .foot a { color: var(--muted); text-decoration: none; }
  .foot a:hover { color: var(--fg); text-decoration: underline; }
  .foot-legal { font-size: 0.8rem; color: var(--faint); border-top: 1px solid var(--line); padding-top: 18px; margin: 0; }
</style>
