---
import '@fontsource-variable/archivo/standard.css';
import { IS_DEMO, NOINDEX, url, allCards } from '../lib/data.ts';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string; wide?: boolean }
const { title, description, noindex = false, canonicalPath, wide = false } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL;
const robots = (IS_DEMO || NOINDEX || noindex) ? 'noindex, nofollow' : 'index, follow';
const canonical = site && canonicalPath ? new URL(url(canonicalPath), site).toString() : null;
// Footer fact, computed at build time from the records themselves: the most recent content verification date.
const lastVerified = allCards().map((c) => c.freshness.last_content_verified_at ?? '').filter(Boolean).sort().at(-1)?.slice(0, 10) ?? null;
const publishedCount = allCards().filter((c) => c.record_status === 'published' || c.is_demo).length;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · CryptoScanner</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0f1320" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {IS_DEMO && (
      <div class="demo-banner" role="status">
        Demonstration build with <strong>fictional cards</strong>. Nothing here is verified. Not indexable.
      </div>
    )}
    <header class="site-header">
      <nav aria-label="Main">
        <a class="brand" href={url('/')} aria-label="CryptoScanner home">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="2" y="7" width="28" height="18" rx="3.5" fill="currentColor" opacity=".18"/><rect x="2" y="7" width="28" height="18" rx="3.5" fill="none" stroke="currentColor" stroke-width="2"/><rect x="6" y="13" width="7" height="5" rx="1" fill="currentColor"/><path d="M16 11v10" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round"/></svg>
          <span class="brand-word">Crypto<b>Scanner</b></span>
        </a>
        <ul>
          <li><a href={url('/')}>Cards</a></li>
          <li><a href={url('/compare')}>Compare</a></li>
          <li><a href={url('/calculator')}>Calculator</a></li>
          <li><a href={url('/methodology')}>Method</a></li>
          <li><a href={url('/how-we-make-money')}>Funding</a></li>
        </ul>
      </nav>
    </header>
    <main id="main" class={`container${wide ? ' wide' : ''}`}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container foot">
        <div>
          <p class="foot-brand">CryptoScanner</p>
          <p>Compares crypto cards from their published conditions. Every figure carries its source and the date it was checked. Unknown stays unknown: it is never shown as zero or free.</p>
          {lastVerified && <p class="foot-fact">{publishedCount} card{publishedCount === 1 ? '' : 's'} listed, sources last checked {lastVerified}</p>}
        </div>
        <div>
          <p class="foot-h">Site</p>
          <ul>
            <li><a href={url('/')}>All cards</a></li>
            <li><a href={url('/compare')}>Compare</a></li>
            <li><a href={url('/calculator')}>Calculator</a></li>
            <li><a href={url('/graveyard')}>Closed cards</a></li>
          </ul>
        </div>
        <div>
          <p class="foot-h">Trust</p>
          <ul>
            <li><a href={url('/methodology')}>How cards are verified</a></li>
            <li><a href={url('/how-we-make-money')}>How we make money</a></li>
            <li><a href={url('/contact')}>Report an error</a></li>
            <li><a href={url('/legal')}>Legal &amp; privacy</a></li>
          </ul>
        </div>
        <p class="foot-legal">CryptoScanner does not hold funds, run identity checks or submit applications. Listing a card is not a guarantee that an issuer will accept you. Nothing here is financial, legal or tax advice. Some outbound links are affiliate links; they are marked and never change the ranking. Card names and logos belong to their owners and identify the products compared.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Ink & brass. One self-hosted typeface (Archivo, variable weight + width; no third-party font request) carries the whole identity:
     expanded + heavy for figures and titles, normal width for reading. */
  :root {
    --bg: #0f1320; --surface: #161b2b; --surface-2: #1d2335; --line: #2a3146; --line-strong: #3a4360;
    --fg: #f3f5f9; --muted: #9aa4b8; --faint: #6b7489;
    --accent: #f0c36a; --accent-fg: #1a1402; --accent-soft: rgba(240, 195, 106, 0.14);
    --ok: #5ce0b8; --ok-soft: rgba(92, 224, 184, 0.14);
    --unk: #c9b37e; --unk-soft: rgba(201, 179, 126, 0.12);
    --bad: #ff8a80; --bad-soft: rgba(255, 138, 128, 0.14);
    --warn-bg: #3a2f0e; --warn-fg: #ffd87a;
    --face-a: #232a40; --face-b: #121626;
    --r-panel: 18px; --r-face: 14px; --r-ctl: 10px; --tap: 44px;
    --font: "Archivo Variable", "Archivo", "Helvetica Neue", Arial, sans-serif;
    --shadow-face: 0 24px 48px -24px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(255, 255, 255, 0.06) inset;
    color-scheme: dark;
    font-family: var(--font); font-size: 16px; line-height: 1.55;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) { --bg: #f6f7f9; --surface: #ffffff; --surface-2: #eef0f5; --line: #e1e4ea; --line-strong: #c9ced9; --fg: #121623; --muted: #5b6478; --faint: #8a93a6; --accent: #8a5a00; --accent-fg: #ffffff; --accent-soft: rgba(138, 90, 0, 0.1); --ok: #0b7a5a; --ok-soft: rgba(11, 122, 90, 0.1); --unk: #7a5d12; --unk-soft: rgba(122, 93, 18, 0.1); --bad: #b3261e; --bad-soft: rgba(179, 38, 30, 0.08); --warn-bg: #fff3cd; --warn-fg: #6b4e00; --face-a: #2b3350; --face-b: #151a2c; --shadow-face: 0 20px 40px -22px rgba(18, 22, 35, 0.45); color-scheme: light; }
  }
  :root[data-theme="light"] { --bg: #f6f7f9; --surface: #ffffff; --surface-2: #eef0f5; --line: #e1e4ea; --line-strong: #c9ced9; --fg: #121623; --muted: #5b6478; --faint: #8a93a6; --accent: #8a5a00; --accent-fg: #ffffff; --accent-soft: rgba(138, 90, 0, 0.1); --ok: #0b7a5a; --ok-soft: rgba(11, 122, 90, 0.1); --unk: #7a5d12; --unk-soft: rgba(122, 93, 18, 0.1); --bad: #b3261e; --bad-soft: rgba(179, 38, 30, 0.08); --warn-bg: #fff3cd; --warn-fg: #6b4e00; --face-a: #2b3350; --face-b: #151a2c; --shadow-face: 0 20px 40px -22px rgba(18, 22, 35, 0.45); color-scheme: light; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--fg); overflow-x: hidden; }
  body { min-height: 100dvh; display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; }
  main { flex: 1; }
  a { color: var(--fg); text-decoration-color: var(--accent); text-underline-offset: 3px; }
  a:hover { text-decoration-color: var(--fg); }
  a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible, summary:focus-visible, label:has(> input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--accent); color: var(--accent-fg); padding: 8px 12px; border-radius: 8px; }
  .skip:focus { left: 8px; z-index: 10; }
  .container { width: 100%; max-width: 1120px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .demo-banner { background: var(--warn-bg); color: var(--warn-fg); padding: 10px 16px; text-align: center; font-size: 0.9rem; }

  /* Header */
  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 84%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .site-header nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 16px; max-width: 1120px; margin: 0 auto; flex-wrap: wrap; }
  .site-header ul { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; max-width: 100%; }
  .site-header ul::-webkit-scrollbar { display: none; }
  @media (max-width: 639px) { .site-header ul { width: 100%; margin-left: -10px; padding-right: 16px; } }
  .site-header li a { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 11px; text-decoration: none; color: var(--muted); border-radius: var(--r-ctl); font-weight: 500; font-size: 0.95rem; white-space: nowrap; }
  .site-header li a:hover { color: var(--fg); background: var(--surface-2); }
  .brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--fg); min-height: var(--tap); }
  .brand-mark { width: 26px; height: 26px; }
  .brand-word { font-weight: 500; font-size: 1.1rem; letter-spacing: -0.01em; font-stretch: 108%; }
  .brand-word b { font-weight: 800; }

  /* Type scale (1.25) */
  h1 { font-weight: 800; font-stretch: 112%; font-size: clamp(2rem, 5.2vw, 3.25rem); line-height: 1.02; letter-spacing: -0.03em; margin: 28px 0 12px; text-wrap: balance; }
  h2 { font-weight: 700; font-stretch: 106%; font-size: 1.5rem; line-height: 1.15; letter-spacing: -0.02em; margin: 32px 0 10px; text-wrap: balance; }
  h3 { font-weight: 700; font-size: 1.125rem; line-height: 1.25; letter-spacing: -0.01em; margin: 20px 0 6px; }
  h4 { font-weight: 600; font-size: 0.95rem; margin: 14px 0 4px; color: var(--muted); }
  p { margin: 0 0 12px; }
  .muted { color: var(--muted); }
  .hint { color: var(--muted); font-size: 0.875rem; margin: 6px 0 0; }
  .lede { font-size: 1.1rem; color: var(--muted); max-width: 40rem; line-height: 1.5; }
  .num { font-variant-numeric: tabular-nums; }

  /* Controls */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: var(--tap); padding: 0 18px; border-radius: var(--r-ctl); border: 1px solid var(--line-strong); background: var(--surface); color: var(--fg); text-decoration: none; font: inherit; font-weight: 600; cursor: pointer; }
  .btn:hover { border-color: var(--fg); }
  .btn.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
  .btn.primary:hover { filter: brightness(1.06); }
  .btn[aria-disabled="true"] { opacity: 0.5; pointer-events: none; }
  label { display: block; font-weight: 600; margin-bottom: 6px; }
  select, input { width: 100%; min-height: var(--tap); padding: 8px 12px; border: 1px solid var(--line-strong); border-radius: var(--r-ctl); background: var(--surface); color: var(--fg); font: inherit; }
  .field { margin-bottom: 14px; min-width: 0; }

  /* Surfaces: panels hold data, faces represent cards (see CardFace) */
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-panel); padding: 18px; min-width: 0; }
  .grid { display: grid; gap: 14px; }
  @media (min-width: 700px) { .grid.cols-2 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 700px) and (max-width: 999px) { .grid.cols-3 { grid-template-columns: 1fr 1fr; } }
  .kv { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 8px 14px; font-size: 0.95rem; margin: 0; }
  .kv dt { color: var(--muted); } .kv dd { margin: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }

  /* Status language: verified = solid mint, unknown = dashed (a hole in the data), contradiction = coral */
  .badge { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.01em; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--muted); white-space: nowrap; line-height: 1.4; vertical-align: middle; }
  .badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex: none; }
  .badge.ok { border-color: transparent; background: var(--ok-soft); color: var(--ok); }
  .badge.bad { border-color: transparent; background: var(--bad-soft); color: var(--bad); }
  .badge.unk { background: var(--unk-soft); color: var(--unk); border: 1px dashed currentColor; }
  .badge.unk::before { background: transparent; border: 1.5px solid currentColor; width: 6px; height: 6px; }

  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  th, td { text-align: left; padding: 12px 12px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  tr:last-child td, tr:last-child th { border-bottom: 0; }
  th { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
  td { font-variant-numeric: tabular-nums; }
  details summary { cursor: pointer; min-height: var(--tap); display: flex; align-items: center; font-weight: 600; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .plain { list-style: none; padding: 0; margin: 0; }
  .prose { max-width: 44rem; } .prose p, .prose li { font-size: 1.02rem; line-height: 1.6; } .prose h1 { margin-top: 36px; } .prose h2 { margin-top: 36px; }

  /* Footer */
  .site-footer { border-top: 1px solid var(--line); margin-top: 64px; padding: 36px 0 40px; color: var(--muted); font-size: 0.9rem; background: var(--surface); }
  .foot { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .foot { grid-template-columns: 2fr 1fr 1fr; } .foot-legal { grid-column: 1 / -1; } }
  .foot-brand { color: var(--fg); font-weight: 800; font-stretch: 108%; font-size: 1.1rem; margin: 0 0 8px; }
  .foot-fact { color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }
  .foot-h { color: var(--fg); font-weight: 700; margin: 0 0 8px; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .foot a { color: var(--muted); text-decoration: none; }
  .foot a:hover { color: var(--fg); text-decoration: underline; }
  .foot-legal { font-size: 0.8rem; color: var(--faint); border-top: 1px solid var(--line); padding-top: 18px; margin: 0; }
</style>
