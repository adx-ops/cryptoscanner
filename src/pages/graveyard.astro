---
import Base from '../layouts/Base.astro';
import { allCards } from '../lib/data.ts';
// Cards that are no longer an available option: suspended, closed, or retired records.
// They stay documented (with their history) but never appear as recommendations.
const gone = allCards().filter((c) => c.product_status === 'suspended' || c.product_status === 'closed' || c.record_status === 'retired');
---
<Base title="Graveyard — closed and suspended crypto cards" description="Crypto cards that were suspended, closed or withdrawn, kept for the record with their last known conditions and dates." canonicalPath="/graveyard">
  <p class="eyebrow">For the record</p>
  <h1>Graveyard</h1>
  <p class="lede">Cards that are suspended, closed or withdrawn. They are kept here with their last verified conditions so that old recommendations and comparisons can be checked, but they are never shown as available options.</p>
  {gone.length === 0 ? (
    <div class="card"><p style="margin:0"><strong>Nothing here yet.</strong> No card in the catalogue is currently recorded as suspended or closed. When a provider withdraws a product, its record moves here with the date and the source of the change.</p></div>
  ) : (
    <div class="grid cols-2">
      {gone.map((c) => (
        <article class="card">
          <h3 style="margin:0 0 4px"><a href={`/cards/${c.slug}`}>{c.name}</a></h3>
          <p class="muted" style="margin:0 0 8px">{c.brand} · {c.category.replace('_', ' ')}</p>
          <p style="margin:0"><span class="badge bad">{c.product_status === 'active' ? c.record_status : c.product_status}</span> {c.changelog.length ? <span class="muted">last change {c.changelog.at(-1)?.date.slice(0, 10)}: {c.changelog.at(-1)?.reason}</span> : null}</p>
        </article>
      ))}
    </div>
  )}
</Base>
<style>.lede { color: var(--muted); max-width: 40rem; }</style>
