---
import Base from '../layouts/Base.astro';
import CountrySelect from '../components/CountrySelect.astro';
import CardTile from '../components/CardTile.astro';
import CardVisual from '../components/CardVisual.astro';
import BrandMark from '../components/BrandMark.astro';
import { allCards, outboundLink, url, IS_DEMO } from '../lib/data.ts';
import { rankCards, bestFor, shortRegion } from '../lib/present.ts';
import research from '../../data/research-list.json';
import logos from '../../data/logos/manifest.json';

const cards = allCards();
const ranked = rankCards(cards);
const picks = ranked.filter((r) => r.facts.available);
const top = picks[0];
const best = bestFor(ranked);
const rankOf = new Map(picks.map((r, i) => [r.card.slug, i + 1]));
const chipClass = (known: boolean, status: string) => (!known ? 'chip unk' : status === 'contradictory' || status === 'stale' ? 'chip bad' : 'chip');

// "Next up": names from the public research list only (no figures, no card-record data). Logos by brand name.
const marks = (logos as { marks: Record<string, { brand: string }> }).marks;
const published = new Set(cards.map((c) => c.name));
const nextUp = IS_DEMO ? [] : (research as { entries: { provider: string; product: string; status: string }[] }).entries
  .filter((e) => (e.status === 'validated' || e.status === 'reading') && !published.has(e.product))
  .map((e) => ({ ...e, providerId: Object.entries(marks).find(([, m]) => e.provider.toLowerCase().startsWith(m.brand.toLowerCase()))?.[0] ?? null }));
---
<Base title="Best crypto cards in Europe, verified" description="Crypto cards ranked on verified cashback, fees and availability by country — from the providers' published conditions, sourced and dated. No sponsored rankings." canonicalPath="/">
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Verified from official sources · no sponsored rankings</p>
      <h1>The best crypto cards. Verified, not sponsored.</h1>
      <p class="lede">Cashback, fees and who can actually get the card — taken from each provider's own published conditions, with the source and the date we checked. Pick your country and see what you can order today.</p>
      <CountrySelect />
      <div class="hero-cta">
        <a class="btn primary lg" href="#picks">See the ranking</a>
        <a class="btn lg" href={url('/calculator')}>What is a card worth to me?</a>
      </div>
    </div>
    {top && (
      <div class="hero-visual">
        <CardVisual card={top.card} size="hero" decorative />
        <div class="hero-tag">
          <span class="kicker" style="margin:0">#1 right now</span>
          <strong>{top.card.name}</strong>
          <span class="muted">{top.facts.cashback.known ? `${top.facts.cashback.value} cashback` : 'see conditions'} · {shortRegion(top.facts.region)}</span>
        </div>
      </div>
    )}
  </section>

  <section class="trust" aria-label="How this site works">
    <div><strong>Official sources only</strong><span>Terms, fee schedules, help centres. Never other comparison sites.</span></div>
    <div><strong>Two reads, 24 h apart</strong><span>A card is published only when two independent reads agree.</span></div>
    <div><strong>Unknown stays unknown</strong><span>A fee we could not verify is shown as unknown, never as zero.</span></div>
    <div><strong>Commissions never rank</strong><span>Affiliate links are marked. The order never depends on them.</span></div>
  </section>

  {picks.length > 0 && (
    <section id="picks" aria-labelledby="picks-h" class="ranking">
      <div class="section-head">
        <h2 id="picks-h">Top picks</h2>
        <p class="muted">Ranked by verified base cashback, then by monthly cost. Same order for everyone — commissions never count.</p>
      </div>
      <ol class="rank-list plain">
        {picks.map(({ card, facts }, i) => { const link = outboundLink(card); return (
          <li class="rank-row">
            <span class="rank-n num" aria-hidden="true">{i + 1}</span>
            <a class="rank-thumb" href={url(`/cards/${card.slug}`)} aria-hidden="true" tabindex="-1"><CardVisual card={card} size="thumb" decorative /></a>
            <div class="rank-main">
              <a class="rank-name" href={url(`/cards/${card.slug}`)}>{card.name}</a>
              <span class="rank-sub muted">{shortRegion(facts.region)} · {facts.kyc.value}{facts.verified ? ` · checked ${facts.verified}` : ''}</span>
            </div>
            <ul class="chips rank-chips">
              <li class={chipClass(facts.cashback.known, facts.cashback.status)}>Cashback <b>{facts.cashback.value}</b></li>
              <li class={chipClass(facts.fx.known, facts.fx.status)}>FX <b>{facts.fx.value}</b></li>
              <li class={chipClass(facts.cost.known, facts.cost.status)}>Monthly <b>{facts.cost.value}</b></li>
            </ul>
            <div class="rank-cta">
              <a class="btn primary" href={link.href} rel={link.monetised ? 'sponsored noopener' : 'noopener'} target="_blank">Get card</a>
              <span class="linknote muted">{link.monetised ? 'affiliate link' : 'not an affiliate link'}</span>
            </div>
          </li>
        ); })}
      </ol>
    </section>
  )}

  {best.length > 0 && (
    <section aria-labelledby="best-h" class="bestfor">
      <h2 id="best-h">Best for</h2>
      <div class="best-grid">
        {best.map((b) => (
          <a class="best-item" href={url(`/cards/${b.card.slug}`)}>
            <span class="kicker">{b.label}</span>
            <span class="best-fig">{b.figure}</span>
            <span class="best-name">{b.card.name}</span>
            <span class="muted small">{b.why}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="catalogue" class="catalogue">
    <div class="toolbar">
      <h2 id="catalogue">All verified cards <span class="muted num" id="count">({cards.length})</span></h2>
      <div class="filters">
        <label class="chk"><input type="checkbox" id="f-eligible" /> Available in my country</label>
        <label class="chk"><input type="checkbox" id="f-nokyc" /> No initial ID check</label>
        <label class="chk"><input type="checkbox" id="f-free" /> No subscription</label>
        <select id="sort" aria-label="Sort by">
          <option value="reward">Sort: cashback</option>
          <option value="name">Sort: name</option>
          <option value="verified">Sort: recently verified</option>
        </select>
        <button type="button" class="btn" id="reset">Reset <span id="active-count" class="muted"></span></button>
      </div>
    </div>
    {cards.length === 0 && (
      <div class="card"><p><strong>No verified cards yet.</strong> The catalogue only lists cards whose conditions were checked against official sources.</p></div>
    )}
    <div class="grid cols-3" id="list">
      {cards.map((c) => <CardTile card={c} rank={rankOf.get(c.slug)} />)}
    </div>
    <p id="empty" class="card" hidden>No card matches these filters for the selected country. Try removing a filter.</p>
  </section>

  {nextUp.length > 0 && (
    <section aria-labelledby="next-h" class="nextup">
      <div class="section-head">
        <h2 id="next-h">Being verified now</h2>
        <p class="muted">{nextUp.length} more cards are in our verification pipeline. They appear here with their figures once two independent reads of the official conditions agree.</p>
      </div>
      <ul class="next-grid plain">
        {nextUp.map((e) => (
          <li class="next-item">
            {e.providerId ? <BrandMark providerId={e.providerId} brand={e.provider} size={30} onSurface /> : <span class="next-brand">{e.provider}</span>}
            <span class="next-prod muted">{e.product}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="faq-h" class="faq">
    <h2 id="faq-h">Questions</h2>
    <details><summary>How is the ranking made?</summary><p>Available cards first, then verified base cashback (highest first), then monthly cost (free first). Nothing else. A card without an affiliate programme can rank above one that pays us.</p></details>
    <details><summary>Why are there so few cards?</summary><p>A card is listed only after two independent reads of the provider's official conditions, at least 24 hours apart, agree on every figure. Cards that fail that bar wait in the pipeline shown above.</p></details>
    <details><summary>What does "unknown" mean?</summary><p>The provider does not publish that value, or we could not read it on an official page. We never assume a fee is zero or a card is available.</p></details>
    <details><summary>Do you check my identity or hold my money?</summary><p>No. Identity checks, applications and funds are handled by the provider only. We never ask for documents, card numbers or passwords.</p></details>
  </section>

  <div class="compare-bar" id="compare-bar" hidden>
    <span id="compare-count">0 selected</span>
    <a class="btn primary" id="compare-go" href={url('/compare')} aria-disabled="true">Compare</a>
  </div>
</Base>

<style>
  .hero { display: grid; gap: 28px; padding: 24px 0 8px; align-items: center; }
  .hero h1 { margin-top: 4px; }
  .hero-copy { max-width: 40rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .hero-visual { position: relative; }
  .hero-visual::before { content: ""; position: absolute; inset: 10% 0 -6%; background: radial-gradient(closest-side, var(--accent-soft), transparent); filter: blur(30px); z-index: 0; }
  .hero-visual > :global(.visual) { position: relative; z-index: 1; box-shadow: var(--shadow-face); }
  .hero-tag { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 2px; margin: -34px 14px 0; padding: 12px 14px; background: color-mix(in srgb, var(--surface) 92%, transparent); border: 1px solid var(--line); border-radius: 12px; backdrop-filter: blur(10px); font-size: 0.9rem; }
  .hero-tag strong { font-weight: 800; font-stretch: 112%; text-transform: uppercase; font-size: 1.05rem; }
  @media (min-width: 900px) { .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px; padding-top: 48px; } }

  .trust { display: grid; gap: 10px; grid-template-columns: 1fr; margin-top: 44px; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .trust div { display: flex; flex-direction: column; gap: 3px; font-size: 0.88rem; color: var(--muted); }
  .trust strong { color: var(--fg); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.8rem; }
  @media (min-width: 700px) { .trust { grid-template-columns: repeat(4, 1fr); gap: 20px; } }

  .section-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
  .section-head h2 { margin-bottom: 0; }
  .section-head p { margin: 0; max-width: 44rem; }

  /* Ranked rows */
  .rank-list { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--r-panel); overflow: hidden; background: var(--surface); }
  .rank-row { display: grid; grid-template-columns: auto 92px minmax(0, 1fr); grid-template-areas: "n thumb main" "n chips chips" "n cta cta"; gap: 10px 12px; align-items: center; padding: 14px 14px; border-bottom: 1px solid var(--line); }
  .rank-row:last-child { border-bottom: 0; }
  .rank-n { grid-area: n; align-self: start; font-weight: 800; font-stretch: 118%; font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1; color: var(--faint); width: 2ch; }
  .rank-row:first-child .rank-n { color: var(--accent); }
  .rank-thumb { grid-area: thumb; display: block; width: 92px; }
  .rank-main { grid-area: main; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .rank-name { font-weight: 800; font-stretch: 112%; text-transform: uppercase; font-size: 1.05rem; text-decoration: none; }
  .rank-name:hover { text-decoration: underline; }
  .rank-sub { font-size: 0.82rem; }
  .rank-chips { grid-area: chips; }
  .rank-cta { grid-area: cta; display: flex; align-items: center; gap: 10px; }
  .linknote { font-size: 0.74rem; }
  @media (min-width: 860px) {
    .rank-row { grid-template-columns: 3ch 110px minmax(0, 1.2fr) minmax(0, 1.4fr) auto; grid-template-areas: "n thumb main chips cta"; padding: 14px 18px; }
    .rank-thumb { width: 110px; }
    .rank-cta { flex-direction: column; align-items: flex-end; gap: 4px; }
  }

  /* Best for */
  .best-grid { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .best-grid { grid-template-columns: repeat(4, 1fr); } }
  .best-item { display: flex; flex-direction: column; gap: 4px; padding: 16px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); text-decoration: none; min-width: 0; }
  .best-item:hover { border-color: var(--accent); }
  .best-fig { font-weight: 800; font-stretch: 118%; font-size: clamp(1.5rem, 4vw, 2.2rem); line-height: 1; letter-spacing: -0.02em; }
  .best-name { font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.02em; }
  .small { font-size: 0.8rem; }

  /* Catalogue */
  .catalogue { margin-top: 8px; }
  .toolbar { display: flex; flex-direction: column; gap: 12px; margin: 0 0 16px; }
  .toolbar h2 { margin-bottom: 0; }
  @media (min-width: 900px) { .toolbar { flex-direction: row; align-items: flex-end; justify-content: space-between; } }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .filters select { width: auto; border-radius: 999px; }
  .chk { display: inline-flex; align-items: center; gap: 8px; min-height: var(--tap); padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 999px; font-weight: 600; cursor: pointer; background: var(--surface); font-size: 0.9rem; margin: 0; }
  .chk:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .chk input { width: 18px; height: 18px; min-height: 0; margin: 0; accent-color: var(--accent); }

  /* Next up */
  .next-grid { display: grid; gap: 8px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 700px) { .next-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .next-grid { grid-template-columns: repeat(4, 1fr); } }
  .next-item { display: flex; flex-direction: column; gap: 6px; padding: 12px; border: 1px dashed var(--line-strong); border-radius: 12px; min-width: 0; }
  .next-brand { font-weight: 800; text-transform: uppercase; font-stretch: 110%; }
  .next-prod { font-size: 0.8rem; }

  /* FAQ */
  .faq details { border-bottom: 1px solid var(--line); padding: 4px 0; }
  .faq summary { font-size: 1rem; }
  .faq p { color: var(--muted); margin: 0 0 12px; max-width: 44rem; }

  .compare-bar[hidden] { display: none; }
  .compare-bar { position: sticky; bottom: 12px; z-index: 4; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 8px 8px 18px; margin: 20px auto 0; max-width: 480px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 999px; box-shadow: 0 16px 40px -16px rgba(0, 0, 0, 0.8); font-weight: 700; }
</style>

<script>
  const list = document.getElementById('list')!;
  const tiles = () => Array.from(list.querySelectorAll<HTMLElement>('.tile'));
  const fEligible = document.getElementById('f-eligible') as HTMLInputElement;
  const fNoKyc = document.getElementById('f-nokyc') as HTMLInputElement;
  const fFree = document.getElementById('f-free') as HTMLInputElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const reset = document.getElementById('reset')!;
  const activeCount = document.getElementById('active-count')!;
  const empty = document.getElementById('empty')!;
  const count = document.getElementById('count')!;
  let country = '';

  function verdict(t: HTMLElement): 'eligible' | 'ineligible' | 'to_confirm' | 'none' {
    if (!country) return 'none';
    const allowed = (t.dataset.allowed || '').split(',').filter(Boolean);
    const excluded = (t.dataset.excluded || '').split(',').filter(Boolean);
    if (excluded.includes(country)) return 'ineligible';
    if (allowed.includes(country)) return 'eligible';
    return t.dataset.default === 'ineligible' ? 'ineligible' : 'to_confirm';
  }

  function render() {
    let shown = 0;
    let active = 0;
    if (fEligible.checked) active++; if (fNoKyc.checked) active++; if (fFree.checked) active++;
    for (const t of tiles()) {
      const v = verdict(t);
      t.dataset.elig = v;
      const b = t.querySelector<HTMLElement>('.elig-badge');
      if (b) {
        b.className = 'badge elig-badge ' + (v === 'eligible' ? 'ok' : v === 'ineligible' ? 'bad' : v === 'to_confirm' ? 'unk' : '');
        b.textContent = v === 'none' ? 'Select a country' : v === 'eligible' ? `Available in ${country}` : v === 'ineligible' ? `Not available in ${country}` : `Availability in ${country}: to confirm`;
      }
      const txt = t.textContent || '';
      let ok = t.dataset.available === '1';
      if (fEligible.checked && v !== 'eligible') ok = false;
      if (fNoKyc.checked && !txt.includes('No initial ID check')) ok = false;
      if (fFree.checked && !/Monthly\s*free/.test(txt)) ok = false;
      t.hidden = !ok;
      if (ok) shown++;
    }
    const rank = { eligible: 0, none: 1, to_confirm: 1, ineligible: 2 } as const;
    const key = (t: HTMLElement) => {
      if (sort.value === 'reward') { const m = /Base reward\s*([\d.]+)%/.exec(t.textContent || ''); return -(m ? parseFloat(m[1]) : 0); }
      if (sort.value === 'verified') { const m = /Sources checked\s*(\d{4}-\d{2}-\d{2})/.exec(t.textContent || ''); return m ? -Date.parse(m[1]) : 0; }
      return 0;
    };
    tiles().sort((a, b) => rank[a.dataset.elig as keyof typeof rank] - rank[b.dataset.elig as keyof typeof rank] || key(a) - key(b) || (a.textContent || '').localeCompare(b.textContent || '')).forEach((t) => list.appendChild(t));
    empty.hidden = shown > 0;
    count.textContent = `(${shown})`;
    activeCount.textContent = active ? `(${active})` : '';
  }

  document.addEventListener('cs:country', (e) => { country = (e as CustomEvent<string>).detail; render(); });
  [fEligible, fNoKyc, fFree, sort].forEach((el) => el.addEventListener('change', render));
  reset.addEventListener('click', () => { fEligible.checked = fNoKyc.checked = fFree.checked = false; sort.value = 'reward'; render(); });

  // compare selection (max 3), carried in the URL only as card slugs — no personal data
  const bar = document.getElementById('compare-bar')!;
  const go = document.getElementById('compare-go') as HTMLAnchorElement;
  const cc = document.getElementById('compare-count')!;
  function selected() { return tiles().filter((t) => (t.querySelector('.compare-toggle') as HTMLInputElement).checked).map((t) => t.dataset.card!); }
  list.addEventListener('change', (e) => {
    const box = e.target as HTMLInputElement;
    if (!box.classList.contains('compare-toggle')) return;
    const s = selected();
    if (s.length > 3) { box.checked = false; return; }
    bar.hidden = s.length === 0;
    cc.textContent = `${s.length} selected (max 3)`;
    go.setAttribute('aria-disabled', s.length < 2 ? 'true' : 'false');
    go.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/compare?cards=${s.join(',')}`;
  });
  render();
</script>
