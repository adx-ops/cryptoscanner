---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CardFace from '../../components/CardFace.astro';
import { allCards, outboundLink, isAvailableOption, payoutLabel, defaultVariantAndTier, rewardSummary, recurringCostSummary, url } from '../../lib/data.ts';
import type { Fee, Reward, CardRecord } from '../../lib/types.ts';
export function getStaticPaths() { return allCards().map((c) => ({ params: { slug: c.slug }, props: { card: c } })); }
const { card } = Astro.props as { card: CardRecord };
const link = outboundLink(card);
const available = isAvailableOption(card);
const { variant: dv, tier: dt } = defaultVariantAndTier(card);
const rs = rewardSummary(dt);
const money = (m?: { amount: number; currency: string }) => (m ? `${m.amount} ${m.currency}` : '');
const feeText = (f: Fee) => {
  if (f.kind === 'none') return 'None';
  if (f.kind === 'unknown') return 'Unknown';
  const parts = [f.amount ? money(f.amount) : '', f.percent !== undefined ? `${f.percent}%` : ''].filter(Boolean).join(' + ');
  const per = f.period ? ` / ${f.period.replace('_', ' ')}` : '';
  const allow = f.free_allowance?.amount ? `; first ${money(f.free_allowance.amount)} per ${f.free_allowance.period ?? 'month'} free` : f.free_allowance?.count !== undefined ? `; first ${f.free_allowance.count} per ${f.free_allowance.period ?? 'month'} free` : '';
  return `${parts}${per}${allow}${f.conditions ? ` — ${f.conditions}` : ''}`;
};
const feeShort = (type: Fee['type']) => { const f = dt.fees.find((x) => x.type === type); return f ? { text: feeText(f).split(' — ')[0], status: f.status } : { text: 'Unknown', status: 'unknown' }; };
const rewardText = (r: Reward) => {
  const amt = r.percent !== undefined ? `${r.percent}%` : r.fixed ? money(r.fixed) : '';
  const unit = payoutLabel(r.payout);
  const cap = r.cap ? (r.cap.basis === 'spend' ? `, on the first ${money(r.cap.amount)} of spend/${r.cap.period}` : `, capped at ${money(r.cap.amount)}/${r.cap.period}`) : '';
  const req = r.requires && r.requires !== 'none' ? `, requires ${r.requires}` : '';
  const win = r.valid_until ? `, until ${r.valid_until}` : '';
  const excl = r.excluded_categories?.length ? `; excludes ${r.excluded_categories.join(', ')}` : '';
  return `${amt} paid in ${unit}${cap}${req}${win}${excl}${r.conditions ? ` — ${r.conditions}` : ''}`;
};
const kycLabel = { required: 'ID verification required', not_required_initially: 'No initial ID check', unknown: 'Unknown' }[dv.kyc.initial_verification];
const allowedCount = dv.eligibility.residence_allowed.length;
const availabilityText = allowedCount ? `${allowedCount} countr${allowedCount === 1 ? 'y' : 'ies'} listed` : dv.eligibility.residence_excluded.length ? `all except ${dv.eligibility.residence_excluded.length} listed` : 'No country list published';
const fx = feeShort('fx'); const atm = feeShort('atm_withdrawal');
const baseReward = dt.rewards.find((r) => r.type === 'base' && r.status !== 'stale' && r.status !== 'contradictory');
const sub = dt.fees.find((f) => f.type === 'subscription');
const meta = [card.category.replace('_', ' '), card.form_factors.join(' + '), card.custody.replace('_', '-'), card.network && card.network !== 'unknown' ? card.network : null].filter(Boolean) as string[];
---
<Base title={`${card.name} — rewards, fees, availability`} description={card.editorial.summary ?? `${card.name}: rewards, fees, availability by country and identity-check requirements, with sources.`} canonicalPath={`/cards/${card.slug}`}>
  <p class="crumb"><a href={url('/')}>All cards</a></p>
  <section class="card-hero">
    <div class="card-hero-face"><CardFace card={card} size="hero" decorative /></div>
    <div class="card-hero-copy">
      <h1>{card.name}</h1>
      <ul class="chips plain">{meta.map((m) => <li>{m}</li>)}</ul>
      {!available && <p class="card alert"><strong>This product is {card.product_status}.</strong> It is kept for reference and is not an available option.</p>}
      {card.editorial.summary && <p class="lede">{card.editorial.summary}</p>}
      <div class="cta">
        {available
          ? <a class="btn primary" href={link.href} rel={link.monetised ? 'sponsored noopener' : 'noopener'} target="_blank">{link.monetised ? `Go to ${card.brand} (affiliate link)` : `Go to ${card.brand} (not an affiliate link)`}</a>
          : <span class="btn" aria-disabled="true">Not available</span>}
        <a class="btn" href={url(`/calculator?card=${card.slug}`)}>Estimate my net value</a>
      </div>
    </div>
  </section>

  <section class="glance card" aria-labelledby="glance">
    <h2 id="glance">At a glance <span class="muted">{dv.region_label}, {dt.name} tier</span></h2>
    <dl class="glance-grid">
      <div><dt>Availability</dt><dd>{availabilityText} <StatusBadge s={dv.eligibility.status ?? 'unknown'} /></dd></div>
      <div><dt>Identity check</dt><dd>{kycLabel} <StatusBadge s={dv.kyc.status} /></dd></div>
      <div><dt>Base reward</dt><dd>{rs.base} {baseReward && <StatusBadge s={baseReward.status} />}</dd></div>
      <div><dt>Monthly cost</dt><dd>{recurringCostSummary(dt)} {sub && <StatusBadge s={sub.status} />}</dd></div>
      <div><dt>Foreign-currency fee</dt><dd>{fx.text} <StatusBadge s={fx.status} /></dd></div>
      <div><dt>ATM withdrawal</dt><dd>{atm.text} <StatusBadge s={atm.status} /></dd></div>
    </dl>
    <p class="hint">Status explained: <strong>verified</strong> = read on an official page on the date shown below; <strong>unknown</strong> = not published, never assumed to be zero. <a href={url('/methodology')}>Method</a>.</p>
  </section>

  <div class="grid cols-3 verdicts">
    <section class="card"><h2>Good for</h2><ul>{(card.editorial.good_for ?? []).map((x) => <li>{x}</li>)}</ul></section>
    <section class="card"><h2>Not for</h2><ul>{(card.editorial.not_for ?? []).map((x) => <li>{x}</li>)}</ul></section>
    {card.editorial.watch_outs?.length ? <section class="card watch"><h2>Watch out</h2><ul>{card.editorial.watch_outs.map((x) => <li>{x}</li>)}</ul></section> : null}
  </div>

  {card.variants.map((v) => (
    <section class="variant">
      <h2>{v.region_label} <span class="muted">({v.currency})</span></h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>Availability by residence</h3>
          <p>Open to residents of: {v.eligibility.residence_allowed.length ? v.eligibility.residence_allowed.join(', ') : 'none listed'} <StatusBadge s={v.eligibility.status ?? 'unknown'} /></p>
          <p>Excluded: {v.eligibility.residence_excluded.length ? v.eligibility.residence_excluded.join(', ') : 'none listed'}.<br />Other countries: {v.eligibility.default_for_unlisted === 'ineligible' ? 'not eligible' : 'to confirm with the provider'}.</p>
          {v.eligibility.nationality_restrictions_note && <p>Nationality: {v.eligibility.nationality_restrictions_note}</p>}
          {v.eligibility.usage_note && <p>Usage: {v.eligibility.usage_note}</p>}
        </div>
        <div class="card">
          <h3>Identity verification</h3>
          <p>{v.kyc.initial_verification.replace(/_/g, ' ')} <StatusBadge s={v.kyc.status} /></p>
          <p>Editorial level: <strong>{v.kyc.editorial_level}</strong> (<a href={url('/methodology#kyc')}>what this means</a>)</p>
          <p>{v.kyc.requirements?.length ? `Documents: ${v.kyc.requirements.join(', ').replace(/_/g, ' ')}.` : ''} {v.kyc.stages_note} {v.kyc.thresholds_note}</p>
        </div>
      </div>

      {v.tiers.map((t) => (
        <article class="card tier">
          <h3>{t.name} tier <StatusBadge s={t.access.status} /></h3>
          <p class="muted">Access: {t.access.type === 'free' ? 'free' : t.access.type === 'subscription' ? `subscription ${money(t.access.amount)}/${t.access.period}` : `${t.access.type} ${t.access.token_amount ?? ''} ${t.access.token ?? ''}${t.access.lock_months ? ` for ${t.access.lock_months} months` : ''}`}{t.access.note ? ` — ${t.access.note}` : ''}</p>
          <div class="grid cols-2">
            <div>
              <h4>Rewards</h4>
              <dl class="kv">
                {t.rewards.map((r) => <><dt>{r.type.replace('_', ' ')}</dt><dd>{rewardText(r)} <StatusBadge s={r.status} /></dd></>)}
                {t.rewards.length === 0 && <><dt>Rewards</dt><dd>None documented</dd></>}
              </dl>
            </div>
            <div>
              <h4>Fees</h4>
              <dl class="kv">
                {t.fees.map((f) => <><dt>{f.type.replace('_', ' ')}</dt><dd>{feeText(f)} <StatusBadge s={f.status} /></dd></>)}
              </dl>
            </div>
          </div>
          {t.limits?.length ? <><h4>Limits</h4><dl class="kv">{t.limits.map((l) => <><dt>{l.type.replace('_', ' ')}</dt><dd>{money(l.amount)}{l.period ? ` / ${l.period}` : ''} {l.note ?? ''} <StatusBadge s={l.status} /></dd></>)}</dl></> : null}
          {t.mobile_wallets?.length ? <p class="muted" style="margin:12px 0 0">Mobile wallets: {t.mobile_wallets.join(', ').replace(/_/g, ' ')} <StatusBadge s={t.mobile_wallets_status ?? 'unknown'} /></p> : null}
        </article>
      ))}
    </section>
  ))}

  <section class="sources">
    <h2>Sources and verification</h2>
    <p class="muted">Content last verified: <strong>{card.freshness.last_content_verified_at ? card.freshness.last_content_verified_at.slice(0, 10) : 'not yet verified'}</strong>. Record status: {card.record_status}.</p>
    <ol class="src-list plain">
      {card.evidence.map((e) => (
        <li class="card src">
          <p class="src-head"><a href={e.url} rel="noopener">{e.title}</a> <StatusBadge s={e.verification} /></p>
          <p class="muted small">{e.source_type.replace('_', ' ')}, accessed {e.accessed_at.slice(0, 10)}{e.scope?.countries?.length ? `, scope: ${e.scope.countries.join(', ')}` : ''}</p>
          {e.excerpt && <blockquote>{e.excerpt}</blockquote>}
          {e.contradiction_note && <p class="small"><span class="badge bad">contradiction</span> {e.contradiction_note}</p>}
        </li>
      ))}
    </ol>
    {card.changelog.length > 0 && <><h3>Changes</h3><ul>{card.changelog.map((c) => <li>{c.date.slice(0, 10)}: {c.field} — {c.reason}</li>)}</ul></>}
    <p class="hint">Listing here does not guarantee the issuer will accept you. <a href={url('/contact')}>Report an error</a>.</p>
  </section>
</Base>

<style>
  .crumb { margin: 16px 0 0; font-size: 0.9rem; } .crumb a { color: var(--muted); }
  .card-hero { display: grid; gap: 20px; margin-top: 8px; align-items: center; }
  .card-hero-face { max-width: 440px; width: 100%; }
  .card-hero h1 { margin-top: 0; }
  @media (min-width: 860px) { .card-hero { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 40px; margin-top: 20px; } }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; }
  .chips li { font-size: 0.82rem; font-weight: 600; color: var(--muted); border: 1px solid var(--line-strong); border-radius: 999px; padding: 3px 10px; }
  .alert { border-color: var(--bad); margin: 0 0 14px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .glance { margin-top: 28px; }
  .glance h2 { margin: 0 0 14px; font-size: 1.25rem; } .glance h2 .muted { font-weight: 500; font-size: 0.95rem; margin-left: 6px; }
  .glance-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; margin: 0; }
  @media (min-width: 700px) { .glance-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .glance-grid div { min-width: 0; padding: 12px; border-radius: 12px; background: var(--surface-2); }
  .glance-grid dt { color: var(--muted); font-size: 0.8rem; margin-bottom: 4px; }
  .glance-grid dd { margin: 0; font-weight: 700; font-size: 1.05rem; overflow-wrap: anywhere; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .verdicts { margin-top: 14px; }
  .verdicts h2 { margin: 0 0 8px; font-size: 1.15rem; }
  .verdicts ul { margin: 0; padding-left: 18px; } .verdicts li { margin-bottom: 6px; }
  .watch { border-color: color-mix(in srgb, var(--bad) 45%, var(--line)); }
  .variant h2 { margin-top: 40px; }
  .variant h3 { margin-top: 0; }
  .tier { margin-top: 14px; }
  .sources h2 { margin-top: 40px; }
  .src-list { display: grid; gap: 10px; }
  .src { padding: 14px 16px; }
  .src p { margin: 0 0 4px; } .src-head { font-weight: 600; }
  .small { font-size: 0.85rem; }
  blockquote { margin: 8px 0 0; padding: 8px 12px; border-left: 3px solid var(--line-strong); color: var(--muted); font-size: 0.9rem; }
  ul { padding-left: 20px; }
</style>
